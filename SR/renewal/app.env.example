# ==============================================================
#  AI GAME STUDIO — 통합 환경설정 (단일 .env · SSoT)
#  이 파일 하나로 전체 시스템을 구성한다.
#  배치: /srv/office/config/app.env   (chmod 600)
#  사용: conda 서비스는 systemd EnvironmentFile 로 직접 로드.
#        Podman Quadlet(.container)·ports.json 은 bootstrap.sh 가
#        이 파일에서 '렌더링'(Quadlet은 env 치환 불가하므로).
#  규칙: [필수] 표시만 채우면 동작. 나머지는 기본값 그대로 가능.
# ==============================================================

# ── [A] 접속 정보 (서버 담당자/Owner 제공) ───────────────────── [필수]
LLM_GATEWAY=https://studio.example.com:48851/upstream        # 서버 A llama-swap(기제공)
COMFY_BASE=http://__SERVER_B_HOST__:8188                # [필수] 서버 B ComfyUI(기제공)
REDIS_SENTINELS=__host1__:26379,__host2__:26379,__host3__:26379  # [필수] Sentinel 3대
REDIS_MASTER_NAME=mymaster
REDIS_PASSWORD=__CHANGE_ME__                            # [필수] 서버 담당자 제공
PUBLIC_HOST=studio.example.com                               # 외부 공개 도메인(PVE host)

# ── [B] API 토큰 (bootstrap 자동 생성 / 수동: token_urlsafe(32)) ──
RO_TOKEN=__AUTO__
RW_TOKEN=__AUTO__

# ── [C] Discord (Owner 제공) ──────────────────────────────────── [필수]
DISCORD_TOKEN=__CHANGE_ME__
DISCORD_GUILD_ID=__CHANGE_ME__
OWNER_USER_ID=__CHANGE_ME__                             # HITL DM 대상

# ── [D] 바인딩 ─────────────────────────────────────────────────
BIND=127.0.0.1                                          # API 등 conda 서비스. host 역터널 도달(§6.8). DNAT면 0.0.0.0
PODMAN_BIND=0.0.0.0                                     # Qdrant/Phoenix/SearXNG publish(Owner 결정)

# ── [E] 포트 (예약 대역 2810–2829) ─────────────────────────────
PORT_API=2816
PORT_QDRANT_REST=2811
PORT_QDRANT_GRPC=2812
PORT_PHOENIX_UI=2813
PORT_PHOENIX_OTLP=2814
PORT_SEARXNG=2815
PORT_WA_PLAY=2817
PORT_WA_MAPSTORAGE=2818
PORT_WA_ICON=2819
PORT_WA_UPLOADER=2820
# 고정(제3자, 변경 불가): ComfyUI 8188 · WA back gRPC 50051 · Redis Sentinel 26379

# ── [F] 내부 URL (위 포트에서 구성; 기본 그대로) ───────────────
QDRANT_URL=http://127.0.0.1:2811
PHOENIX_OTLP=http://127.0.0.1:2814
SEARXNG_URL=http://127.0.0.1:2815
WA_ORIGIN=https://studio.example.com:2817                    # CORS 허용 origin(=PUBLIC_HOST:PORT_WA_PLAY)
API_BASE=http://127.0.0.1:2816                          # Discord 봇 → API

# ── [G] 모델 (기본 고정; EMBED 변경 시 재색인) ─────────────────
LLM_STRATEGY_MODEL=qwen3.6-35b-a3b
LLM_BASE_MODEL=gemma-4-e4b-qat-it
EMBED_MODEL=dragonkue/BGE-m3-ko
RERANK_MODEL=BAAI/bge-reranker-v2-m3
QDRANT_COLLECTION=knowledge
EMBED_DIM=1024
EMBED_DISTANCE=Cosine

# ── [H] 경로 (기본값; 환경 실태와 다르면 조정) ─────────────────
OFFICE_ROOT=/srv/office
PODMAN_DATA=/srv/podman/data
VAULT_DIR=/srv/office/vault
STATE_DIR=/srv/office/state
ORCH_DB=/srv/office/state/orch.sqlite
CONDA_BASE=/opt/conda                              # 'conda info --base' 로 확인
DISPLAY=:99                                             # Playwright 가상 디스플레이(기제공)
PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers       # (기제공·재사용)

# ── [I] 지식 원본 / 외부 인입 ──────────────────────────────────
VAULT_REMOTE=__git@github.com:owner/vault.git__         # [필수] GitHub Pro private repo
RCLONE_REMOTE=gdrive                                    # rclone Google Drive remote 이름
DRIVE_INTAKE_FOLDER=__CHANGE_ME__                       # 인입 소스 공유 Drive 폴더

# ── [J] WorkAdventure (PUBLIC_HOST·포트에서 빌드; 권위 변수는 §13 repo) ──
START_ROOM_URL=__GITHUB_PAGES_MAP_URL__                 # GitHub Pages map-starter-kit
# PUSHER_URL/PUBLIC_MAP_STORAGE_URL/ICON_URL/UPLOADER_URL 는
# 빌드 시 PUBLIC_HOST + PORT_WA_* 로 조합 주입(§9.2). PUSHER_URL 끝슬래시 금지.
