{"id":"ko-01","lang":"ko","prompt":"김민준 고객의 CRM 정보를 조회해줘. 고객 ID는 C-2041이야.","tools":[{"type":"function","function":{"name":"crm_get_customer","description":"고객 ID로 CRM에서 고객 정보를 조회합니다","parameters":{"type":"object","properties":{"customer_id":{"type":"string","description":"고객 ID"}},"required":["customer_id"]}}},{"type":"function","function":{"name":"crm_list_customers","description":"CRM 고객 목록을 검색합니다","parameters":{"type":"object","properties":{"query":{"type":"string","description":"검색어"},"limit":{"type":"integer","description":"최대 결과 수"}},"required":["query"]}}}],"expected":{"name":"crm_get_customer","args":{"customer_id":"C-2041"}}}
{"id":"ko-02","lang":"ko","prompt":"오늘 오후 3시에 '마케팅 전략 회의' 일정을 내 캘린더에 등록해줘. 장소는 2층 회의실이고 참석자는 없어.","tools":[{"type":"function","function":{"name":"calendar_create_event","description":"캘린더에 새 일정을 등록합니다","parameters":{"type":"object","properties":{"title":{"type":"string","description":"일정 제목"},"datetime":{"type":"string","description":"ISO 8601 형식 날짜시간"},"location":{"type":"string","description":"장소"},"attendees":{"type":"array","items":{"type":"string"},"description":"참석자 이메일 목록"}},"required":["title","datetime"]}}}],"expected":{"name":"calendar_create_event","args":{"title":"마케팅 전략 회의","datetime":null,"location":"2층 회의실","attendees":[]}}}
{"id":"ko-03","lang":"ko","prompt":"'인공지능 스타트업 투자 동향 2026' 주제로 웹 검색해줘.","tools":[{"type":"function","function":{"name":"web_search","description":"인터넷에서 정보를 검색합니다","parameters":{"type":"object","properties":{"query":{"type":"string","description":"검색 쿼리"},"num_results":{"type":"integer","description":"결과 수 (기본값 5)"}},"required":["query"]}}},{"type":"function","function":{"name":"document_search","description":"내부 문서 저장소에서 문서를 검색합니다","parameters":{"type":"object","properties":{"query":{"type":"string"},"folder":{"type":"string"}},"required":["query"]}}}],"expected":{"name":"web_search","args":{"query":"인공지능 스타트업 투자 동향 2026"}}}
{"id":"ko-04","lang":"ko","prompt":"park.jihye@client.example.com으로 이메일을 보내줘. 제목은 '견적서 발송'이고 본문은 첨부 견적서를 검토해 달라는 내용으로 써줘.","tools":[{"type":"function","function":{"name":"email_send","description":"이메일을 발송합니다","parameters":{"type":"object","properties":{"to":{"type":"string","description":"수신자 이메일"},"subject":{"type":"string","description":"이메일 제목"},"body":{"type":"string","description":"이메일 본문"}},"required":["to","subject","body"]}}}],"expected":{"name":"email_send","args":{"to":"park.jihye@client.example.com","subject":"견적서 발송","body":null}}}
{"id":"ko-05","lang":"ko","prompt":"다음 텍스트를 영어로 번역해줘: '저희 제품은 중소기업의 업무 자동화를 위해 설계되었습니다.'","tools":[{"type":"function","function":{"name":"translate_text","description":"텍스트를 지정한 언어로 번역합니다","parameters":{"type":"object","properties":{"text":{"type":"string","description":"번역할 원문"},"target_language":{"type":"string","description":"목표 언어 코드 (예: en, ja, zh)"},"source_language":{"type":"string","description":"원본 언어 코드 (자동 감지 시 생략)"}},"required":["text","target_language"]}}},{"type":"function","function":{"name":"text_summarize","description":"긴 텍스트를 요약합니다","parameters":{"type":"object","properties":{"text":{"type":"string"},"max_length":{"type":"integer"}},"required":["text"]}}}],"expected":{"name":"translate_text","args":{"text":"저희 제품은 중소기업의 업무 자동화를 위해 설계되었습니다.","target_language":"en"}}}
{"id":"ko-06","lang":"ko","prompt":"내일 오전 9시에 'ABC 거래처 미팅 준비' 리마인더를 설정해줘.","tools":[{"type":"function","function":{"name":"reminder_set","description":"지정한 시각에 리마인더를 설정합니다","parameters":{"type":"object","properties":{"message":{"type":"string","description":"리마인더 메시지"},"remind_at":{"type":"string","description":"ISO 8601 형식 알림 시각"}},"required":["message","remind_at"]}}},{"type":"function","function":{"name":"calendar_create_event","description":"캘린더에 새 일정을 등록합니다","parameters":{"type":"object","properties":{"title":{"type":"string"},"datetime":{"type":"string"}},"required":["title","datetime"]}}}],"expected":{"name":"reminder_set","args":{"message":"ABC 거래처 미팅 준비","remind_at":null}}}
{"id":"ko-07","lang":"ko","prompt":"이번 달 매출 데이터를 DB에서 조회해줘. 2026년 6월 기준으로.","tools":[{"type":"function","function":{"name":"sales_query","description":"매출 데이터베이스를 조회합니다","parameters":{"type":"object","properties":{"year":{"type":"integer","description":"조회 연도"},"month":{"type":"integer","description":"조회 월 (1-12)"},"aggregation":{"type":"string","enum":["daily","weekly","monthly"],"description":"집계 단위"}},"required":["year","month"]}}},{"type":"function","function":{"name":"order_query","description":"주문 데이터베이스를 조회합니다","parameters":{"type":"object","properties":{"status":{"type":"string","enum":["pending","completed","cancelled"]},"start_date":{"type":"string"},"end_date":{"type":"string"}},"required":["status"]}}}],"expected":{"name":"sales_query","args":{"year":2026,"month":6}}}
{"id":"ko-08","lang":"ko","prompt":"회사 블로그에 새 포스팅을 올려줘. 제목: 'AI가 바꾸는 1인 기업의 미래', 카테고리는 'tech'로 설정하고 공개 상태로 발행해줘.","tools":[{"type":"function","function":{"name":"blog_publish","description":"블로그에 새 포스트를 게시합니다","parameters":{"type":"object","properties":{"title":{"type":"string","description":"포스트 제목"},"content":{"type":"string","description":"포스트 본문 (마크다운)"},"category":{"type":"string","description":"카테고리"},"status":{"type":"string","enum":["draft","published"],"description":"발행 상태"}},"required":["title","content","category","status"]}}}],"expected":{"name":"blog_publish","args":{"title":"AI가 바꾸는 1인 기업의 미래","content":null,"category":"tech","status":"published"}}}
{"id":"ko-09","lang":"ko","prompt":"현재 USD/KRW 환율을 조회해줘.","tools":[{"type":"function","function":{"name":"exchange_rate_get","description":"두 통화 간의 현재 환율을 조회합니다","parameters":{"type":"object","properties":{"base":{"type":"string","description":"기준 통화 코드 (예: USD)"},"target":{"type":"string","description":"대상 통화 코드 (예: KRW)"}},"required":["base","target"]}}},{"type":"function","function":{"name":"weather_get","description":"특정 도시의 현재 날씨를 조회합니다","parameters":{"type":"object","properties":{"city":{"type":"string"},"unit":{"type":"string","enum":["celsius","fahrenheit"]}},"required":["city"]}}}],"expected":{"name":"exchange_rate_get","args":{"base":"USD","target":"KRW"}}}
{"id":"ko-10","lang":"ko","prompt":"'2026년 사업계획서.docx' 파일을 요약해서 'summary_2026.md' 파일로 저장해줘.","tools":[{"type":"function","function":{"name":"document_summarize_and_save","description":"문서를 요약하고 결과를 파일로 저장합니다","parameters":{"type":"object","properties":{"source_file":{"type":"string","description":"요약할 원본 파일 경로"},"output_file":{"type":"string","description":"저장할 파일 경로"},"format":{"type":"string","enum":["markdown","txt","html"],"description":"출력 형식"}},"required":["source_file","output_file"]}}},{"type":"function","function":{"name":"file_create","description":"새 파일을 생성합니다","parameters":{"type":"object","properties":{"filename":{"type":"string"},"content":{"type":"string"},"directory":{"type":"string"}},"required":["filename","content"]}}}],"expected":{"name":"document_summarize_and_save","args":{"source_file":"2026년 사업계획서.docx","output_file":"summary_2026.md","format":"markdown"}}}
{"id":"ko-11","lang":"ko","prompt":"인스타그램에 새 포스트를 올려줘. 이미지 경로는 '/images/product_launch.jpg'이고 캡션은 신제품 출시 소식을 알리는 내용으로 써줘. 해시태그는 #신제품 #출시 #스타트업으로 해줘.","tools":[{"type":"function","function":{"name":"sns_post_instagram","description":"인스타그램에 게시물을 올립니다","parameters":{"type":"object","properties":{"image_path":{"type":"string","description":"이미지 파일 경로"},"caption":{"type":"string","description":"게시물 캡션"},"hashtags":{"type":"array","items":{"type":"string"},"description":"해시태그 목록 (# 포함)"}},"required":["image_path","caption","hashtags"]}}},{"type":"function","function":{"name":"sns_post_twitter","description":"트위터/X에 게시물을 올립니다","parameters":{"type":"object","properties":{"text":{"type":"string"},"media_path":{"type":"string"}},"required":["text"]}}}],"expected":{"name":"sns_post_instagram","args":{"image_path":"/images/product_launch.jpg","caption":null,"hashtags":["#신제품","#출시","#스타트업"]}}}
{"id":"ko-12","lang":"ko","prompt":"서울 날씨 알려줘. 섭씨로.","tools":[{"type":"function","function":{"name":"weather_get","description":"특정 도시의 현재 날씨를 조회합니다","parameters":{"type":"object","properties":{"city":{"type":"string","description":"도시명"},"unit":{"type":"string","enum":["celsius","fahrenheit"],"description":"온도 단위"}},"required":["city","unit"]}}},{"type":"function","function":{"name":"exchange_rate_get","description":"두 통화 간의 현재 환율을 조회합니다","parameters":{"type":"object","properties":{"base":{"type":"string"},"target":{"type":"string"}},"required":["base","target"]}}}],"expected":{"name":"weather_get","args":{"city":"서울","unit":"celsius"}}}
