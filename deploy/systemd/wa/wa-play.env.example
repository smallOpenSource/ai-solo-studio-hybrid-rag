# SR/renewal §9.2 — WorkAdventure `play` 브릭 env 템플릿 (포트모델·결정③).
# ★AGPL_COMPLIANCE.md 결정③: traefik 제거 + 포트모델. 경로(PathPrefix)라우팅·리버스프록시
#   없음 → 각 외부 브릭은 포트(ports.json 2817-2820)로 직접 노출되고 절대 URL 로 배선한다.
# ★PUSHER_URL/PUBLIC_* 외부 URL 은 **끝슬래시 제거**(compose 원본 `https://${DOMAIN}/` 의
#   끝슬래시는 OIDC/`Invalid playUri` 함정·§9.2). 내부 URL(API_URL/INTERNAL_*)은 VM-로컬·
#   컨테이너 DNS 유지.
#
# 사용: 이 파일을 wa-play.env 로 복사하고 ${...} 자리를 Owner 제공 값으로 채운다.
#   cp deploy/systemd/wa/wa-play.env.example ~/.config/containers/systemd/wa-play.env
# ★시크릿(SECRET_KEY/ROOM_API_SECRET_KEY)은 이 example 에 두지 말 것(gitignored env 로만).
# ★클린-env 원칙: NODE_ENV 를 설정하지 않는다(브릭 이미지 기본값 사용). 브릭마다 별도 env
#   파일을 두어 한 브릭의 변수가 다른 브릭으로 새지 않게 한다(§9.1 NODE_ENV 오염 차단).

# ── 외부(공개 도메인:포트·절대 URL·끝슬래시 제거) — pending Owner: 도메인+TLS ──
# DOMAIN/포트는 ports.json(PORT_WA_PLAY=2817·MAPSTORAGE=2818·ICON=2819·UPLOADER=2820).
PUSHER_URL=https://studio.example.com:2817
FRONT_URL=https://studio.example.com:2817
PUBLIC_MAP_STORAGE_URL=https://studio.example.com:2818/map-storage
ICON_URL=https://studio.example.com:2819
UPLOADER_URL=https://studio.example.com:2820
# 입장 맵(GitHub Pages map-starter-kit) — pending Owner(§9.1·부재 시 입장 불가).
START_ROOM_URL=

# ── 내부(VM-로컬·컨테이너 DNS·호스트 비노출) ──
API_URL=back:50051
INTERNAL_MAP_STORAGE_URL=http://map-storage:3000
REDIS_HOST=redis
ROOM_API_PORT=50051

# ── 기능 토글(비밀 아님) ──
ENABLE_CHAT=true
ENABLE_MAP_EDITOR=false
DISABLE_ANONYMOUS=false
ENABLE_OPENAPI_ENDPOINT=true

# ── 시크릿(★여기 두지 말 것 — gitignored wa-play.env 로만 주입) ──
# SECRET_KEY=<owner-provided>
# ROOM_API_SECRET_KEY=<owner-provided>
