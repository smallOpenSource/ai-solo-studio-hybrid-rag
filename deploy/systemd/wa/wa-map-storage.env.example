# SR/renewal §9.2 — WorkAdventure `map-storage` 브릭 env 템플릿 (포트모델·결정③·브릭 클린-env).
# ★PATH_PREFIX 제거(포트모델: PathPrefix /map-storage 대신 포트 2818 루트 서빙). NODE_ENV 미설정.
# 사용: cp deploy/systemd/wa/wa-map-storage.env.example ~/.config/containers/systemd/wa-map-storage.env
#
# ── 내부(컨테이너 DNS) ──
API_URL=back:50051
# 외부 입장 검증(play)을 위해 PUSHER_URL 은 외부 절대 URL(끝슬래시 제거) — pending Owner: 도메인.
PUSHER_URL=https://studio.example.com:2817
# 인증 전략(기본: 비활성·로컬 검증용). 운영은 Owner 정책.
AUTHENTICATION_STRATEGY=
ENABLE_BEARER_AUTHENTICATION=false
ENABLE_BASIC_AUTHENTICATION=false
# ── 시크릿(★여기 두지 말 것 — gitignored env 로만) ──
# SECRET_KEY=<owner-provided·play 와 동일값>
# MAP_STORAGE_API_TOKEN=<owner-provided>
