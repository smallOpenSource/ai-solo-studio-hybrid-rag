# SR/renewal §9.2 — WorkAdventure `back` 브릭 env 템플릿 (포트모델·결정③·브릭 클린-env).
# 내부 전용 서비스(외부 노출 없음). play 와 시크릿(SECRET_KEY) 공유. ★NODE_ENV 미설정(클린-env).
# 사용: cp deploy/systemd/wa/wa-back.env.example ~/.config/containers/systemd/wa-back.env
#
# ── 외부 참조 URL(끝슬래시 제거·결정③) — pending Owner: 도메인 ──
PLAY_URL=https://studio.example.com:2817
PUBLIC_MAP_STORAGE_URL=https://studio.example.com:2818/map-storage
# ── 내부(컨테이너 DNS) ──
MAP_STORAGE_URL=map-storage:50053
INTERNAL_MAP_STORAGE_URL=http://map-storage:3000
REDIS_HOST=redis
# ── 기능 토글 ──
ENABLE_MAP_EDITOR=false
ENABLE_CHAT=true
# ── 시크릿(★여기 두지 말 것 — gitignored wa-back.env 로만) ──
# SECRET_KEY=<owner-provided·play 와 동일값>
