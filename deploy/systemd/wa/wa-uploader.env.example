# SR/renewal §9.2 — WorkAdventure `uploader` 브릭 env 템플릿 (포트모델·결정③·브릭 클린-env).
# ★NODE_ENV 미설정(클린-env). AWS/S3 미설정 시 uploader 는 로컬 폴백(검증 가능 범위).
# 사용: cp deploy/systemd/wa/wa-uploader.env.example ~/.config/containers/systemd/wa-uploader.env
#
# ── 외부 참조 URL(끝슬래시 제거·결정③) — pending Owner: 도메인 ──
UPLOADER_URL=https://studio.example.com:2820
# ── 내부(컨테이너 DNS) ──
REDIS_HOST=redis
REDIS_PORT=6379
# ── 기능/한도 ──
ENABLE_CHAT_UPLOAD=true
UPLOAD_MAX_FILESIZE=10485760
# ── AWS/S3(선택·미설정 시 로컬 폴백) — Owner 제공 시 채움 ──
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=
# AWS_ENDPOINT=
