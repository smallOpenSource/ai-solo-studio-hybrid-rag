DISCORD_TOKEN_PLANNER=
DISCORD_TOKEN_HR=
DISCORD_TOKEN_DATA=
DISCORD_TOKEN_ACCOUNTANT=
DISCORD_TOKEN_DEV=
DISCORD_TOKEN_DEVOPS=
DISCORD_TOKEN_DESIGNER=
