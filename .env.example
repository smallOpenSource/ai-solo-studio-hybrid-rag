# .env.example - 키 이름만. 실제 값은 .env 에 넣고 커밋하지 않음.
# 지식 레이어(RAG)만 돌릴 때 필요한 값은 BGE_* 와 Qdrant(config/endpoint.yaml knowledge.qdrant_url)뿐.

# --- BGE 임베딩/리랭크 서버 (core/bge_client.py) ---
BGE_EMBEDDING_API_URL=
BGE_EMBEDDING_API_KEY=
BGE_EMBEDDING_MODEL=
BGE_RERANK_API_URL=
BGE_RERANK_API_KEY=
# 선택: 요청 타임아웃(초)
BGE_EMBEDDING_TIMEOUT=
BGE_RERANK_TIMEOUT=

# --- 지식 검색 HTTP 서비스 (knowledge/service.py 를 별도 프로세스로 띄울 때) ---
KNOWLEDGE_SERVICE_URL=

# --- OpenAI 호환 LLM 엔드포인트 (bench/office 경로) ---
BENCH_API_URL=
BENCH_API_KEY=
BENCH_PRIMARY_MODEL=
BENCH_GENERAL_MODEL=
LLM_GATEWAY=

# --- orch provider primary/fallback ---
ORCH_LLM_PRIMARY=
ORCH_IMAGE_PRIMARY=
ORCH_ORG_ROUTING=
ORCH_VAULT_DIR=
# 배포 시 필수. 비우면 orch/app.py 가 테스트용 공개 기본값을 써서 누구나 API 를 호출할 수 있음
ORCH_API_KEY_RO=
ORCH_API_KEY_RW=
API_RO_TOKEN=
API_RW_TOKEN=
RO_TOKEN=
RW_TOKEN=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL_NAME=
AZURE_OPENAI_RESPONSES_API_VERSION=
AZURE_OPENAI_TIMEOUT=
DASHSCOPE_API_KEY=
COMFY_BASE=
COMFY_API_KEY=
COMFY_EP_IMAGE=
COMFY_EP_IMAGE_EDIT=
COMFY_EP_VIDEO=

# --- 웹 오피스 / HITL ---
LOGIN_PASSWORD=
HITL_OWNER_NAME=
HITL_OWNER_PASSWORD=
WEB_BASE_URL=

# --- Redis (선택. REDIS_ENABLED=0 이면 미사용) ---
REDIS_ENABLED=
REDIS_URL=
REDIS_DB=
REDIS_PASSWORD=
REDIS_SENTINEL_HOSTS=
REDIS_MASTER_NAME=
REDIS_SOCKET_CONNECT_TIMEOUT=

# --- Discord 어댑터 (선택) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
OWNER_USER_ID=
DISCORD_TOKEN=
DISCORD_TOKEN_SECRETARY=
DISCORD_TOKEN_PM=
DISCORD_TOKEN_CEO=
DISCORD_TOKEN_STRATEGIST=
DISCORD_TOKEN_CFO=
